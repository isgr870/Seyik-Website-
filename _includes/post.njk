---
layout: base.njk
---
<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Article</p>
    <h1>{{ title }}</h1>
    <p class="page-hero-lead">
      {{ date | readableDate }}{% if author %} · {{ author }}{% endif %}
    </p>
  </div>
</section>

<section class="section about">
  <div class="container" style="max-width: 720px;">
    {% if thumbnail %}
    <img src="{{ thumbnail }}" alt="{{ title }}" style="width:100%; border-radius:12px; margin-bottom:2rem;" />
    {% endif %}
    <div class="article-body">
      {{ content | safe }}
    </div>
    <div style="margin-top: 2.5rem;">
      <a href="/blog/" class="btn btn-outline">← Back to Articles</a>
    </div>
  </div>
</section>
