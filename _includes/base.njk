<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% if title %}{{ title }} – SEYIK{% else %}SEYIK – Skill & Equip Youth Initiative for Karamoja{% endif %}</title>
  <meta name="description" content="{{ description or 'SEYIK empowers youth in Karamoja through skills training, economic opportunities, and climate action.' }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo-link">
        <img src="/seyik-logo.png" alt="SEYIK Logo" class="logo" />
        <span class="logo-text">SEYIK</span>
      </a>
      <nav class="main-nav" id="mainNav">
        <a href="/about/" {% if page.url == '/about/' %}class="active"{% endif %}>About</a>
        <a href="/programs/" {% if page.url == '/programs/' %}class="active"{% endif %}>Programs</a>
        <a href="/impact/" {% if page.url == '/impact/' %}class="active"{% endif %}>Impact</a>
        <a href="/climate/" {% if page.url == '/climate/' %}class="active"{% endif %}>Climate Action</a>
        <a href="/blog/" {% if '/blog/' in page.url %}class="active"{% endif %}>Articles</a>
        <a href="/get-involved/" {% if page.url == '/get-involved/' %}class="active"{% endif %}>Get Involved</a>
        <a href="/contact/" class="btn btn-primary nav-cta">Contact Us</a>
      </nav>
      <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  {{ content | safe }}

  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <img src="/seyik-logo.png" alt="SEYIK" class="footer-logo" />
        <p>Skill & Equip Youth Initiative for Karamoja</p>
        <p class="tagline">Empowered Youth, Voices Of Change</p>
      </div>
      <div class="footer-links">
        <h4>Quick Links</h4>
        <a href="/about/">About</a>
        <a href="/programs/">Programs</a>
        <a href="/blog/">Articles</a>
        <a href="/climate/">Climate Action</a>
        <a href="/get-involved/">Get Involved</a>
        <a href="/contact/">Contact</a>
      </div>
      <div class="footer-contact">
        <h4>Contact</h4>
        <a href="mailto:info.seyik@24.org">info.seyik@24.org</a>
        <a href="tel:+256788547969">+256 788 547 969</a>
        <a href="https://x.com/Skill_Youth_kja" target="_blank" rel="noopener">@Skill_Youth_kja</a>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="container">
        <p>© 2026 Skill & Equip Youth Initiative for Karamoja (SEYIK). All rights reserved.</p>
      </div>
    </div>
  </footer>

  <script src="/script.js"></script>
</body>
</html>
